/*
 * combined_h7s78 -- STM32H7S78-DK touchscreen SVPWM controller
 *
 * Merges the LVGL display/touch UI (dk_h7s78) with the SPI4 slave link
 * (h7s78_spi_slave). The touchscreen sets the SVPWM reference (electrical
 * frequency + voltage magnitude); the SPI slave packs it into an 8-byte
 * frame, asserts PD12, and the G474RE SPI1 master clocks it and drives its
 * TIM1 SVPWM controller.
 *
 * Display/touch: the DK's native LTDC RGB panel (800x480) and GT911 I2C touch
 * controller are already enabled by the board dts, so no display nodes are
 * needed here.
 *
 * SPI4 SLAVE on the Pmod CN4 connector:
 *   pin2 MOSI = PE14 (SPI4_MOSI)
 *   pin3 MISO = PE13 (SPI4_MISO)
 *   pin4 SCK  = PE12 (SPI4_SCK)
 *   pin1 CS   = PE4  / software slave-select (SSM=1): slave is always
 *                    selected; no NSS AF needed.
 *
 * NOTE: The dk_h7s78 demo previously muxed TIM1_CH3 onto PE13 for a leftover
 * SVPWM demo on the H7S78. That demo is dropped so PE13 is free for
 * SPI4_MISO; the real SVPWM runs on the G474RE (g474_svpwm project).
 */

&spi4 {
	status = "okay";
	pinctrl-0 = <&spi4_sck_pe12 &spi4_miso_pe13 &spi4_mosi_pe14>;
	pinctrl-names = "default";
};
